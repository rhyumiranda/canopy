#!/usr/bin/env bash
# canopy — an orchestration layer for AI coding agents.
# Thin glue CLI; behavior lives in Claude Code agents/skills/hooks.
set -euo pipefail

# Resolve the canopy install root (this file lives in <root>/bin/canopy).
CANOPY_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CANOPY_ROOT="$(cd "$CANOPY_BIN/.." && pwd)"
export CANOPY_ROOT

# shellcheck source=../lib/common.sh
. "$CANOPY_ROOT/lib/common.sh"
# shellcheck source=../lib/state.sh
. "$CANOPY_ROOT/lib/state.sh"
# shellcheck source=../lib/worktree.sh
. "$CANOPY_ROOT/lib/worktree.sh"
# shellcheck source=../lib/worker.sh
. "$CANOPY_ROOT/lib/worker.sh"
# shellcheck source=../lib/checks.sh
. "$CANOPY_ROOT/lib/checks.sh"
# shellcheck source=../lib/review.sh
. "$CANOPY_ROOT/lib/review.sh"
# shellcheck source=../lib/pr.sh
. "$CANOPY_ROOT/lib/pr.sh"
# shellcheck source=../lib/watch.sh
. "$CANOPY_ROOT/lib/watch.sh"
# shellcheck source=../lib/scribe.sh
. "$CANOPY_ROOT/lib/scribe.sh"
# shellcheck source=../lib/setup.sh
. "$CANOPY_ROOT/lib/setup.sh"
# shellcheck source=../lib/recover.sh
. "$CANOPY_ROOT/lib/recover.sh"

usage() {
  cat <<'EOF'
canopy — orchestration layer for AI coding agents

usage: canopy <command> [args]

commands:
  init                 Initialize .canopy/ in the current repo (idempotent)
  status               Print the task board
  task add <title>     Add a task (prints its id)
  task set <id> <k> <v>  Set a field on a task
  task status <id> <s>   Set a task's status
  task show <id>       Print a task's full detail
  mode [yolo|guided]   Get or set the global mode
  version              Print version

run 'canopy <command> -h' where available.
EOF
}

cmd="${1:-}"; shift || true
case "$cmd" in
  init)          canopy_init "$@" ;;
  status)        state_board ;;
  task)
    sub="${1:-}"; shift || true
    case "$sub" in
      add)       task_add "$@" ;;
      set)       task_set "$@" ;;
      status)    task_status "$@" ;;
      checkpoint) task_checkpoint "$@" ;;
      show)      task_show "$@" ;;
      *)         die "unknown 'task' subcommand: ${sub:-<none>}" ;;
    esac ;;
  recover)       canopy_recover "$@" ;;
  worktree)
    sub="${1:-}"; shift || true
    case "$sub" in
      lease)     canopy_worktree_lease "$@" ;;
      return)    canopy_worktree_return "$@" ;;
      path)      canopy_worktree_path "$@" ;;
      *)         die "unknown 'worktree' subcommand: ${sub:-<none>}" ;;
    esac ;;
  worker)
    sub="${1:-}"; shift || true
    case "$sub" in
      spawn)     canopy_worker_spawn "$@" ;;
      fix)       canopy_worker_fix "$@" ;;
      logs)      canopy_worker_logs "$@" ;;
      stop)      canopy_worker_stop "$@" ;;
      *)         die "unknown 'worker' subcommand: ${sub:-<none>}" ;;
    esac ;;
  review)        canopy_review "$@" ;;
  pr)
    sub="${1:-}"; shift || true
    case "$sub" in
      open)      canopy_pr_open "$@" ;;
      checks)    canopy_pr_checks "$@" ;;
      *)         die "unknown 'pr' subcommand: ${sub:-<none>}" ;;
    esac ;;
  watch)
    sub="${1:-}"; shift || true
    case "$sub" in
      once)      canopy_watch_once "$@" ;;
      install)   canopy_watch_install "$@" ;;
      ""|loop)   canopy_watch "$@" ;;
      *)         die "unknown 'watch' subcommand: ${sub:-<none>}" ;;
    esac ;;
  checks)
    sub="${1:-}"; shift || true
    case "$sub" in
      run)       canopy_checks_run "$@" ;;
      status)    canopy_checks_status "$@" ;;
      show)      canopy_checks_show "$@" ;;
      *)         die "unknown 'checks' subcommand: ${sub:-<none>}" ;;
    esac ;;
  scribe)
    sub="${1:-}"; shift || true
    case "$sub" in
      add)       canopy_scribe_add "$@" ;;
      show)      canopy_scribe_show ;;
      *)         die "unknown 'scribe' subcommand: ${sub:-<none>}" ;;
    esac ;;
  setup)         canopy_setup "$@" ;;
  mode)          state_mode "$@" ;;
  version|-v|--version) echo "canopy ${CANOPY_VERSION}" ;;
  ""|-h|--help|help) usage ;;
  *)             die "unknown command: $cmd (try 'canopy help')" ;;
esac
