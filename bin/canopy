#!/usr/bin/env bash
# canopy — an orchestration layer for AI coding agents.
# Thin glue CLI; behavior lives in Claude Code agents/skills/hooks.
set -euo pipefail

# Resolve the canopy install root (this file lives in <root>/bin/canopy).
# `canopy setup` symlinks this onto PATH (~/.local/bin/canopy), so BASH_SOURCE may
# be a symlink — follow the chain to the real file, else lib/ can't be found.
_src="${BASH_SOURCE[0]}"
while [ -h "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
CANOPY_BIN="$(cd -P "$(dirname "$_src")" && pwd)"
CANOPY_ROOT="$(cd "$CANOPY_BIN/.." && pwd)"
unset _src _dir
export CANOPY_ROOT

# shellcheck source=../lib/common.sh
. "$CANOPY_ROOT/lib/common.sh"
# shellcheck source=../lib/state.sh
. "$CANOPY_ROOT/lib/state.sh"
# shellcheck source=../lib/agent.sh
. "$CANOPY_ROOT/lib/agent.sh"
# shellcheck source=../lib/channel.sh
. "$CANOPY_ROOT/lib/channel.sh"
# shellcheck source=../lib/worktree.sh
. "$CANOPY_ROOT/lib/worktree.sh"
# shellcheck source=../lib/worker.sh
. "$CANOPY_ROOT/lib/worker.sh"
# shellcheck source=../lib/checks.sh
. "$CANOPY_ROOT/lib/checks.sh"
# shellcheck source=../lib/review.sh
. "$CANOPY_ROOT/lib/review.sh"
# shellcheck source=../lib/consult.sh
. "$CANOPY_ROOT/lib/consult.sh"
# shellcheck source=../lib/pr.sh
. "$CANOPY_ROOT/lib/pr.sh"
# shellcheck source=../lib/watch.sh
. "$CANOPY_ROOT/lib/watch.sh"
# shellcheck source=../lib/scribe.sh
. "$CANOPY_ROOT/lib/scribe.sh"
# shellcheck source=../lib/setup.sh
. "$CANOPY_ROOT/lib/setup.sh"
# shellcheck source=../lib/doctor.sh
. "$CANOPY_ROOT/lib/doctor.sh"
# shellcheck source=../lib/upgrade.sh
. "$CANOPY_ROOT/lib/upgrade.sh"
# shellcheck source=../lib/recover.sh
. "$CANOPY_ROOT/lib/recover.sh"
# shellcheck source=../lib/start.sh
. "$CANOPY_ROOT/lib/start.sh"
# shellcheck source=../lib/project.sh
. "$CANOPY_ROOT/lib/project.sh"

usage() {
  cat <<'EOF'
canopy — orchestration layer for AI coding agents

usage: canopy <command> [args]

commands:
  init                 Initialize .canopy/ in the current repo (idempotent)
  start                Open an agent AS the orchestrator (Claude default; --codex experimental)
  status [--all]       Print the task board (--all: every registered project, ids as <name>:tN)
  task add <title>     Add a task (prints its id)
  task set <id> <k> <v>  Set a field on a task
  task status <id> <s>   Set a task's status
  task show <id>       Print a task's full detail
  events [list|consume|wait]  Read one-shot durable lifecycle events
  scribe list          List durable AGENTS.md entries (numbered)
  scribe add <fact>    Append a durable, project-intrinsic fact
  scribe replace <n> <fact>  Rewrite entry n in place
  scribe rm <n>        Delete a stale entry
  oracle [-C <wt>] <q> Ask the read-only advisory oracle one mid-task question (prose)
  plan-gate <id>       Gate the plan at .canopy/plans/<id>.md (structured verdict JSON)
  mode [yolo|guided]   Get or set this repo's mode (--global: read the orchestrator home's session mode)
  base [branch]        Get or set the integration branch (worktrees cut from it; PRs target it)
  project ls           List registered projects (git repos under projects/) with in-flight counts
  project path <name>  Resolve a project name to its absolute path (exact, else unique substring)
  recover --all        Recover across every registered project (re-arm, reconcile, report)
  watch ensure --all   Arm a merge-watcher for each project that has pr-open tasks
  doctor               Check prereqs, PATH, wiring, and install method (read-only)
  upgrade              Pull latest + reinstall the CLI (from any directory)
  version              Print version

run 'canopy <command> -h' where available.
EOF
}

cmd="${1:-}"; shift || true
# Refuse orchestrator-only commands when running as a worker (shared .canopy).
canopy_role_guard "$cmd" "${1:-}"
# First-run auto-wire: a Homebrew install can't write ~/.claude at install time, so
# the first real command lazily wires the Claude/Codex defs when the marker is
# missing/stale. Idempotent, race-safe (mkdir-lock), and skipped for meta commands,
# detached workers, and opt-outs — see lib/setup.sh:_canopy_maybe_autowire.
_canopy_maybe_autowire "$cmd" "$@"
case "$cmd" in
  init)          canopy_init "$@" ;;
  start)         canopy_start "$@" ;;
  status)        state_board "$@" ;;
  task)
    sub="${1:-}"; shift || true
    case "$sub" in
      add)       task_add "$@" ;;
      set)       task_set "$@" ;;
      status)    task_status "$@" ;;
      checkpoint) task_checkpoint "$@" ;;
      show)      task_show "$@" ;;
      *)         usage_error "unknown 'task' subcommand: ${sub:-<none>}" "valid: add, set, status, checkpoint, show" ;;
    esac ;;
  recover)       canopy_recover "$@" ;;
  events)        canopy_events "$@" ;;
  worktree)
    sub="${1:-}"; shift || true
    case "$sub" in
      lease)     canopy_worktree_lease "$@" ;;
      return)    canopy_worktree_return "$@" ;;
      path)      canopy_worktree_path "$@" ;;
      *)         usage_error "unknown 'worktree' subcommand: ${sub:-<none>}" "valid: lease, return, path" ;;
    esac ;;
  worker)
    sub="${1:-}"; shift || true
    case "$sub" in
      spawn)     canopy_worker_spawn "$@" ;;
      fix)       canopy_worker_fix "$@" ;;
      logs)      canopy_worker_logs "$@" ;;
      idle)      canopy_worker_idle "$@" ;;
      stop)      canopy_worker_stop "$@" ;;
      start|attach|send|status|read|resume|reconcile|close|clean)
                 _worker_experimental_only "$sub" ;;
      *)         usage_error "unknown 'worker' subcommand: ${sub:-<none>}" "valid: spawn, fix, logs, idle, stop" ;;
    esac ;;
  base)          state_base "$@" ;;
  project)
    sub="${1:-}"; shift || true
    case "$sub" in
      ls)        canopy_project_ls "$@" ;;
      path)      canopy_project_path "$@" ;;
      *)         usage_error "unknown 'project' subcommand: ${sub:-<none>}" "valid: ls, path" ;;
    esac ;;
  review)        canopy_review "$@" ;;
  oracle)        canopy_oracle "$@" ;;
  plan-gate)     canopy_plan_gate "$@" ;;
  pr)
    sub="${1:-}"; shift || true
    case "$sub" in
      open)      canopy_pr_open "$@" ;;
      checks)    canopy_pr_checks "$@" ;;
      *)         usage_error "unknown 'pr' subcommand: ${sub:-<none>}" "valid: open, checks" ;;
    esac ;;
  watch)
    sub="${1:-}"; shift || true
    case "$sub" in
      once)      canopy_watch_once "$@" ;;
      install)   canopy_watch_install "$@" ;;
      ensure)    canopy_watch_ensure "$@" ;;
      status)    canopy_watch_status ;;
      ""|loop)   canopy_watch "$@" ;;
      *)         usage_error "unknown 'watch' subcommand: ${sub:-<none>}" "valid: once, install, ensure, status, loop" ;;
    esac ;;
  checks)
    sub="${1:-}"; shift || true
    case "$sub" in
      run)       canopy_checks_run "$@" ;;
      status)    canopy_checks_status "$@" ;;
      show)      canopy_checks_show "$@" ;;
      *)         usage_error "unknown 'checks' subcommand: ${sub:-<none>}" "valid: run, status, show" ;;
    esac ;;
  scribe)
    sub="${1:-}"; shift || true
    case "$sub" in
      add)       canopy_scribe_add "$@" ;;
      list)      canopy_scribe_list ;;
      replace)   canopy_scribe_replace "$@" ;;
      rm)        canopy_scribe_rm "$@" ;;
      show)      canopy_scribe_show ;;
      *)         usage_error "unknown 'scribe' subcommand: ${sub:-<none>}" "valid: add, list, replace, rm, show" ;;
    esac ;;
  setup)         canopy_setup "$@" ;;
  doctor)        canopy_doctor "$@" ;;
  upgrade)       canopy_upgrade "$@" ;;
  mode)          state_mode "$@" ;;
  version|-v|--version) echo "canopy ${CANOPY_VERSION}" ;;
  ""|-h|--help|help) usage ;;
  *)             usage_error "unknown command: $cmd" "run 'canopy help' for the command list" ;;
esac
